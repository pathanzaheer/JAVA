import java.util.*;
class Binary{
	static int binary(int a[],int key){
		int n=a.length;
		int low=0;
		int high=n-1;
		for(int i=0;i<=n/2;i++){
			int mid=(low+high)/2;
			if (a[mid]==key){
				return mid;
			}
			else if (a[mid]>key){
				high=mid-1;
			}
			else{
				low=mid+1;
			}
		}
	return -1;
	}
	public static void main(String args[]){
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter the size : ");
		int n = sc.nextInt();
		System.out.print("Enter the key : ");
		int key = sc.nextInt();
		int arr[] = new int[n];
		System.out.println("Enter the elements : ");
		for(int i=0;i<n;i++){
			arr[i]=sc.nextInt();
		}
		Arrays.sort(arr);
		int pos = binary(arr,key);
		if (pos==-1){
			System.out.println("Element is not found");	
		}
		else{
			System.out.println("Element is found at index : " + pos);
		}
	}
}
